# Copy to .env (which is git-ignored) and fill in your values.
# Or use SSH key auth — then password isn't needed.

ROUTER_HOST=192.168.1.1
ROUTER_PORT=22
ROUTER_USER=root

# One of the following — pick one:
# 1) SSH key (recommended). Run `ovpn-pbr keys install` once to set up.
ROUTER_SSH_KEY=~/.ssh/id_openwrt

# 2) Password via OS keyring (no plaintext on disk).
# Run `ovpn-pbr keys store` once — script will prompt for the password.
# Then leave ROUTER_PASSWORD unset.

# 3) Password directly (least secure, but simplest).
# ROUTER_PASSWORD=your_password_here

# Interface name on OpenWrt. Default: vpnclient.
# The nft-set is auto-derived as pbr_${VPN_INTERFACE}_4_dst_ip_user
VPN_INTERFACE=vpnclient

# Remote path for the routes file on OpenWrt
REMOTE_ROUTES_PATH=/etc/pbr.d/vpn-routes.sh
